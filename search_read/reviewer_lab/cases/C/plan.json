{
  "target_language": "c",
  "architecture_pattern": "Strategy with header/source separation",
  "execution_order": [
    "include/gateway_exception.h",
    "include/payment_types.h",
    "include/payment_strategy.h",
    "include/payment_processor.h",
    "src/credit_card_strategy.c",
    "src/paypal_strategy.c",
    "src/payment_processor.c",
    "src/main.c"
  ],
  "files": [
    {"filepath": "include/gateway_exception.h", "action": "CREATE", "dependencies": [], "external_dependencies": [], "purpose": "Gateway error type.", "interface_summary": "GatewayError contains error_code and message."},
    {"filepath": "include/payment_types.h", "action": "CREATE", "dependencies": [], "external_dependencies": [], "purpose": "Payment domain types.", "interface_summary": "Currency enum and PaymentRequest with request_id, amount, currency."},
    {"filepath": "include/payment_strategy.h", "action": "CREATE", "dependencies": ["include/payment_types.h", "include/gateway_exception.h"], "external_dependencies": [], "purpose": "Strategy interface.", "interface_summary": "PaymentStrategy has name and pay callback."},
    {"filepath": "include/payment_processor.h", "action": "CREATE", "dependencies": ["include/payment_strategy.h"], "external_dependencies": [], "purpose": "Processor API.", "interface_summary": "create_processor(strategy), processor_execute(processor pointer, request pointer, error pointer)."},
    {"filepath": "src/credit_card_strategy.c", "action": "CREATE", "dependencies": ["include/payment_strategy.h"], "external_dependencies": [], "purpose": "Credit card payment strategy.", "interface_summary": "Credit card callback returns 1 on success and 0 on invalid amount."},
    {"filepath": "src/paypal_strategy.c", "action": "CREATE", "dependencies": ["include/payment_strategy.h"], "external_dependencies": [], "purpose": "PayPal payment strategy.", "interface_summary": "PayPal callback returns 1 on success and 0 on invalid amount."},
    {"filepath": "src/payment_processor.c", "action": "CREATE", "dependencies": ["include/payment_processor.h"], "external_dependencies": [], "purpose": "Dispatch payments to selected strategy.", "interface_summary": "Processor execute returns the strategy callback result."},
    {"filepath": "src/main.c", "action": "CREATE", "dependencies": ["include/payment_processor.h", "src/credit_card_strategy.c"], "external_dependencies": [], "purpose": "Example application.", "interface_summary": "Runs a valid payment."}
  ],
  "rationale": "Keep shared contracts in headers and implementations in source files."
}
